/* PATCH 004c — PD&I landing v4. Style minimaliste sombre.
   Prefixe .pdiL- : aucune collision possible avec les classes existantes
   (.pdi-unified-*, .pdi-iso-*, Tailwind du moteur V4.8d). */

.pdiL-root {
  --pdiL-bg: #0e0e0e;
  --pdiL-bg2: #111111;
  --pdiL-card: #161616;
  --pdiL-line: #222222;
  --pdiL-dim: #888888;
  --pdiL-soft: #c8c8c8;
  --pdiL-fg: #f0f0f0;
  --pdiL-cyan: #4db8d4;
  --pdiL-green: #4caf7d;
  --pdiL-orange: #e8a838;
  --pdiL-red: #e05555;
  background: var(--pdiL-bg);
  color: var(--pdiL-fg);
  min-height: 100vh;
  width: 100%;
  overflow-x: hidden;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.pdiL-root *, .pdiL-root *::before, .pdiL-root *::after { box-sizing: border-box; }
.pdiL-wrap { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; }

/* ---------- Barre de navigation flottante ---------- */
.pdiL-navhost { position: sticky; top: 0; z-index: 50; padding: 16px 0; }
.pdiL-nav {
  width: 100%; max-width: 1100px; margin: 0 auto;
  display: flex; align-items: center; gap: 16px;
  padding: 10px 14px;
  border: 1px solid var(--pdiL-line);
  border-radius: 999px;
  background: rgba(17, 17, 17, .82);
  backdrop-filter: blur(12px);
  transition: box-shadow .25s ease, transform .25s ease, max-width .25s ease;
}
.pdiL-nav.is-stuck {
  max-width: 940px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, .55);
  transform: translateY(2px);
}
.pdiL-brand { display: flex; align-items: center; gap: 10px; font-weight: 800; letter-spacing: -.02em; }
.pdiL-brand-dot {
  width: 26px; height: 26px; border-radius: 8px; flex: 0 0 auto;
  display: grid; place-items: center;
  font-size: 11px; font-weight: 900; color: #0b0b0b;
  background: linear-gradient(135deg, var(--pdiL-cyan), var(--pdiL-green));
}
.pdiL-navlinks { display: flex; align-items: center; gap: 4px; margin: 0 auto; }
.pdiL-navlink {
  border: 0; background: transparent; cursor: pointer;
  color: var(--pdiL-soft); font-size: 14px; font-weight: 500;
  padding: 8px 14px; border-radius: 999px;
  transition: background .18s ease, color .18s ease;
}
.pdiL-navlink:hover { background: #1c1c1c; color: var(--pdiL-fg); }
.pdiL-navactions { display: flex; align-items: center; gap: 8px; }
.pdiL-btn {
  cursor: pointer; border-radius: 999px; font-size: 14px; font-weight: 600;
  padding: 9px 18px; transition: transform .16s ease, background .18s ease, box-shadow .18s ease;
  white-space: nowrap;
}
.pdiL-btn:active { transform: translateY(1px); }
.pdiL-btn-ghost { border: 1px solid var(--pdiL-line); background: transparent; color: var(--pdiL-soft); }
.pdiL-btn-ghost:hover { background: #1c1c1c; color: var(--pdiL-fg); }
.pdiL-btn-primary {
  border: 0; color: #0b0b0b; background: var(--pdiL-fg);
  box-shadow: 0 6px 18px rgba(240, 240, 240, .12);
}
.pdiL-btn-primary:hover { box-shadow: 0 10px 26px rgba(240, 240, 240, .2); }
.pdiL-burger {
  display: none; border: 1px solid var(--pdiL-line); background: transparent;
  color: var(--pdiL-fg); width: 38px; height: 38px; border-radius: 10px;
  cursor: pointer; font-size: 16px; line-height: 1;
}
.pdiL-mobilemenu {
  display: none; flex-direction: column; gap: 6px;
  margin: 10px auto 0; max-width: 1100px; padding: 14px;
  border: 1px solid var(--pdiL-line); border-radius: 18px;
  background: rgba(17, 17, 17, .96); backdrop-filter: blur(12px);
}
.pdiL-mobilemenu.is-open { display: flex; }
.pdiL-mobilemenu .pdiL-navlink { text-align: left; padding: 12px 10px; }
.pdiL-mobilemenu .pdiL-btn { width: 100%; margin-top: 4px; }

/* ---------- Hero ---------- */
.pdiL-hero { padding: 72px 0 40px; text-align: center; }
.pdiL-kicker {
  display: inline-block; margin-bottom: 20px;
  border: 1px solid var(--pdiL-line); border-radius: 999px;
  padding: 6px 14px; font-size: 11px; font-weight: 700;
  letter-spacing: .14em; text-transform: uppercase; color: var(--pdiL-dim);
}
.pdiL-hero h1 {
  margin: 0 auto 20px; max-width: 900px;
  font-size: clamp(34px, 6vw, 68px); line-height: 1.04;
  font-weight: 800; letter-spacing: -.035em;
}
.pdiL-hero h1 em { font-style: normal; color: var(--pdiL-cyan); }
.pdiL-hero p {
  margin: 0 auto; max-width: 660px;
  font-size: clamp(15px, 1.6vw, 18px); line-height: 1.65;
  color: var(--pdiL-dim); font-weight: 400;
}
.pdiL-herocta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 32px; }
.pdiL-btn-lg { padding: 13px 26px; font-size: 15px; }

/* ---------- Banniere d'information pleine largeur ---------- */
.pdiL-band { width: 100%; display: grid; grid-template-columns: repeat(4, 1fr); margin: 56px 0 0; }
.pdiL-bandcell { padding: 26px 22px; border-top: 1px solid var(--pdiL-line); border-bottom: 1px solid var(--pdiL-line); }
.pdiL-bandcell + .pdiL-bandcell { border-left: 1px solid var(--pdiL-line); }
.pdiL-bandcell b { display: block; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 8px; }
.pdiL-bandcell span { font-size: 13px; line-height: 1.55; color: var(--pdiL-dim); }
.pdiL-band-iso b { color: var(--pdiL-cyan); }
.pdiL-band-vision b { color: var(--pdiL-green); }
.pdiL-band-sketch b { color: var(--pdiL-orange); }
.pdiL-band-json b { color: var(--pdiL-red); }
.pdiL-band-iso { background: linear-gradient(180deg, rgba(77, 184, 212, .10), transparent); }
.pdiL-band-vision { background: linear-gradient(180deg, rgba(76, 175, 125, .10), transparent); }
.pdiL-band-sketch { background: linear-gradient(180deg, rgba(232, 168, 56, .10), transparent); }
.pdiL-band-json { background: linear-gradient(180deg, rgba(224, 85, 85, .10), transparent); }

/* ---------- Titre de section ---------- */
.pdiL-seclabel {
  font-size: 11px; font-weight: 700; letter-spacing: .16em;
  text-transform: uppercase; color: var(--pdiL-dim); margin-bottom: 14px;
}
.pdiL-sec { padding: 72px 0; }
.pdiL-sec h2 {
  margin: 0 0 12px; font-size: clamp(24px, 3.4vw, 40px);
  font-weight: 800; letter-spacing: -.03em;
}
.pdiL-sec > .pdiL-lead { margin: 0 0 34px; max-width: 620px; color: var(--pdiL-dim); line-height: 1.65; }

/* ---------- PD&I en 4 temps ---------- */
.pdiL-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.pdiL-step {
  border: 1px solid var(--pdiL-line); border-radius: 18px;
  background: var(--pdiL-bg2); padding: 22px;
  transition: transform .2s ease, border-color .2s ease;
}
.pdiL-step:hover { transform: translateY(-3px); border-color: #333; }
.pdiL-stepnum { font-size: 11px; font-weight: 800; letter-spacing: .12em; color: var(--pdiL-dim); }
.pdiL-step h3 { margin: 10px 0 8px; font-size: 17px; font-weight: 700; letter-spacing: -.01em; }
.pdiL-step p { margin: 0; font-size: 13px; line-height: 1.6; color: var(--pdiL-dim); }
.pdiL-step-1 h3 { color: var(--pdiL-cyan); }
.pdiL-step-2 h3 { color: var(--pdiL-green); }
.pdiL-step-3 h3 { color: var(--pdiL-orange); }
.pdiL-step-4 h3 { color: var(--pdiL-red); }

/* ---------- Bento ---------- */
.pdiL-bento { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.pdiL-cell {
  border: 1px solid var(--pdiL-line); border-radius: 18px;
  background: var(--pdiL-card); padding: 22px; min-height: 176px;
  display: flex; flex-direction: column; justify-content: flex-end;
  transition: transform .2s ease, border-color .2s ease;
}
.pdiL-cell:hover { transform: translateY(-3px); border-color: #333; }
.pdiL-cell h4 { margin: 0 0 6px; font-size: 15px; font-weight: 700; }
.pdiL-cell p { margin: 0; font-size: 13px; line-height: 1.55; color: var(--pdiL-dim); }
.pdiL-sp2 { grid-column: span 2; }
.pdiL-sp3 { grid-column: span 3; }

/* ---------- Pied de page minimaliste ---------- */
.pdiL-foot { border-top: 1px solid var(--pdiL-line); background: var(--pdiL-bg2); padding: 56px 0 28px; }
.pdiL-footgrid { display: grid; grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr)); gap: 32px; }
.pdiL-footbrand p { margin: 14px 0 0; font-size: 13px; line-height: 1.6; color: var(--pdiL-dim); max-width: 280px; }
.pdiL-footbrand small { display: block; margin-top: 14px; font-size: 12px; color: #666; }
.pdiL-footcol b {
  display: block; margin-bottom: 12px; font-size: 11px; font-weight: 800;
  letter-spacing: .12em; text-transform: uppercase; color: var(--pdiL-fg);
}
.pdiL-footcol a {
  display: block; padding: 5px 0; font-size: 13px; color: var(--pdiL-dim);
  text-decoration: none; cursor: pointer; transition: color .16s ease;
}
.pdiL-footcol a:hover { color: var(--pdiL-fg); }
.pdiL-footbar {
  margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--pdiL-line);
  display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between;
  font-size: 12px; color: #666;
}

/* ---------- Responsive ---------- */
@media (max-width: 1000px) {
  .pdiL-band { grid-template-columns: repeat(2, 1fr); }
  .pdiL-bandcell:nth-child(3) { border-left: 0; }
  .pdiL-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .pdiL-footgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 860px) {
  .pdiL-navlinks, .pdiL-navactions { display: none; }
  .pdiL-burger { display: block; margin-left: auto; }
  .pdiL-hero { padding: 48px 0 28px; }
  .pdiL-sec { padding: 52px 0; }
  .pdiL-bento { grid-template-columns: 1fr; }
  .pdiL-sp2, .pdiL-sp3 { grid-column: span 1; }
}
@media (max-width: 560px) {
  .pdiL-wrap { padding: 0 16px; }
  .pdiL-band { grid-template-columns: 1fr; }
  .pdiL-bandcell + .pdiL-bandcell { border-left: 0; border-top: 0; }
  .pdiL-steps { grid-template-columns: 1fr; }
  .pdiL-footgrid { grid-template-columns: 1fr; }
}
